---
import { getCollection, render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import {
  estimateReadingMinutes,
  isPublished,
  resolveDate,
  resolveTitle,
} from '../../utils/content';

export async function getStaticPaths() {
  const notes = await getCollection('notes', isPublished);
  return notes.map((note) => ({
    params: { slug: note.id },
    props: { note },
  }));
}

const { note } = Astro.props;
const { Content, headings } = await render(note);
---

<ArticleLayout
  title={resolveTitle(note)}
  description={note.data.description}
  date={resolveDate(note)}
  updated={note.data.updated}
  readingMinutes={estimateReadingMinutes(note.body)}
  tags={note.data.tags}
  topic={note.data.topic}
  backHref="/notes"
  backLabel="返回知识目录"
  headings={headings}
>
  <Content />
</ArticleLayout>
