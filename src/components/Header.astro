---
import { SITE } from '../site.config';

const pathname = Astro.url.pathname;
const isActive = (href: string) =>
  pathname === href || pathname.startsWith(`${href}/`);
---

<header class="site-header">
  <div class="header-inner">
    <a href="/" class="brand" aria-label={SITE.title}>
      <span class="brand-mark">{SITE.title}</span>
    </a>

    <nav class="nav-links" aria-label="主导航">
      {SITE.nav.map((item) => (
        <a
          href={item.href}
          class:list={['nav-item', { active: isActive(item.href) }]}
          title={item.title}
        >
          <span class="nav-label-zh">{item.title}</span>
        </a>
      ))}

      <button
        type="button"
        class="icon-btn search-trigger"
        id="open-search-btn"
        aria-label="全局搜索 (Ctrl+K)"
        title="搜索 (Ctrl + K)"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"></circle>
          <path d="m21 21-4.3-4.3"></path>
        </svg>
        <kbd class="search-kbd">⌘K</kbd>
      </button>

      <a
        href={SITE.github}
        target="_blank"
        rel="noopener noreferrer"
        class="icon-btn"
        aria-label="GitHub"
        title="GitHub"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path>
          <path d="M9 18c-4.51 2-5-2-7-2"></path>
        </svg>
      </a>

      <button
        type="button"
        class="icon-btn"
        id="theme-toggle"
        aria-label="切换深浅色主题"
        title="切换深浅色"
      >
        <svg class="sun-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2"></path>
          <path d="M12 20v2"></path>
          <path d="m4.93 4.93 1.41 1.41"></path>
          <path d="m17.66 17.66 1.41 1.41"></path>
          <path d="M2 12h2"></path>
          <path d="M20 12h2"></path>
          <path d="m6.34 17.66-1.41 1.41"></path>
          <path d="m19.07 4.93-1.41 1.41"></path>
        </svg>
        <svg class="moon-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
        </svg>
      </button>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 30;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    background: var(--bg-backdrop);
  }

  .header-inner {
    max-width: 56rem;
    margin: 0 auto;
    padding: 1.25rem 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .brand {
    font-weight: 650;
    font-size: 1.02rem;
    letter-spacing: -0.02em;
    color: var(--fg);
    transition: opacity 0.2s ease;
  }

  .brand:hover {
    opacity: 0.75;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .nav-item {
    font-size: 0.92rem;
    color: var(--fg-muted);
    transition: color 0.18s ease;
    position: relative;
  }

  .nav-item:hover,
  .nav-item.active {
    color: var(--fg);
  }

  .nav-item.active::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -4px;
    height: 1.5px;
    background: var(--fg);
    border-radius: 1px;
  }

  .icon-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    background: transparent;
    border: 0;
    padding: 0.25rem;
    color: var(--fg-muted);
    cursor: pointer;
    transition: color 0.18s ease;
    font-family: inherit;
  }

  .icon-btn:hover {
    color: var(--fg);
  }

  .search-trigger {
    padding: 0.22rem 0.5rem;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--bg-elevated);
  }

  .search-kbd {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--fg-muted);
  }

  .sun-icon {
    display: none;
  }

  .moon-icon {
    display: block;
  }

  :global(html.dark) .sun-icon {
    display: block;
  }

  :global(html.dark) .moon-icon {
    display: none;
  }

  @media (max-width: 560px) {
    .nav-links {
      gap: 0.9rem;
    }

    .search-kbd {
      display: none;
    }

    .search-trigger {
      border: 0;
      background: transparent;
      padding: 0.25rem;
    }
  }
</style>

<script is:inline>
  (() => {
    const btn = document.getElementById('theme-toggle');
    if (!btn) return;
    btn.addEventListener('click', () => {
      const isDark = document.documentElement.classList.toggle('dark');
      const theme = isDark ? 'dark' : 'light';
      localStorage.setItem('theme', theme);
      window.dispatchEvent(new CustomEvent('theme-change', { detail: { theme } }));
    });
  })();
</script>
